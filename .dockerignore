# Patterns here are anchored at the build-context root, unlike .gitignore, so the nested
# forms carry an explicit **/ prefix.
.git
.github
.venv
.venv-lock
tests
docs
infra
# ...except the port-exposure contract, which frontend/reviewer.py imports. A .dockerignore
# entry filters the build CONTEXT, so an excluded path makes `COPY infra/exposure.py` fail
# the build outright rather than produce an image missing a file. The two modules named here
# import nothing outside the standard library.
!infra/__init__.py
!infra/exposure.py
claudedocs
scripts
artifacts
data
wandb
*.spool
**/*.spool
*.pyc
**/*.pyc
__pycache__
**/__pycache__
.pytest_cache
.ruff_cache
.mypy_cache
htmlcov
.coverage
