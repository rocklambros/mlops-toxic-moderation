#!/bin/bash
# ---------------------------------------------------------------------------
# Amazon Linux 2023 (arm64) bootstrap for one tier of the toxic-moderation
# stack. Rendered by templatefile() from infra/terraform/compute.tf, once per
# instance, with that component's name and log group baked in.
#
# This host has no SSH, no bastion and no NAT (foundation spec 7.1). Everything
# below therefore assumes that if it fails, the only evidence available is what
# reached the serial console. Three rules follow from that:
#
#   1. Every line of output goes to /dev/console, so `aws ec2 get-console-output`
#      works even when the SSM agent never registered (premortem C6).
#   2. An ERR trap prints a FAILED marker naming the command that died, because
#      "user data did not finish" is not a diagnosis.
#   3. The script ends with an externally observable COMPLETE marker on three
#      independent channels: the serial console, CloudWatch Logs, and a sentinel
#      file. See section 7.
#
# Ordering rule: anything that can fail on a transient AWS condition runs AFTER
# the systemd unit is installed, so a slow IAM propagation cannot leave the box
# without the thing that starts the application on the next boot.
#
# Nothing secret is written by this script. The instance profile is the only
# credential on the box; there are no static keys anywhere.
# ---------------------------------------------------------------------------
set -Eeuxo pipefail

exec > >(tee /var/log/user-data.log | logger -t user-data -s 2>/dev/console) 2>&1

COMPONENT='${component}'
REGION='${region}'
LOG_GROUP='${log_group}'
APP_DIR=/opt/toxic-mod
ENV_FILE=/etc/toxic-mod.env
UNIT=/etc/systemd/system/toxic-mod.service
SENTINEL=/var/lib/cloud/toxic-mod-bootstrapped

# `docker` searches several cli-plugins directories; /usr/libexec/docker/cli-plugins
# is the one the AL2023 docker package itself owns, so a plugin dropped here is
# found by the packaged CLI with no DOCKER_CONFIG or PATH manipulation.
COMPOSE_PLUGIN_DIR=/usr/libexec/docker/cli-plugins

console() {
  printf '%s\n' "$*" >/dev/console 2>/dev/null || true
  printf '%s\n' "$*"
}

on_error() {
  rc=$?
  console "TOXIC_MOD_USER_DATA_FAILED component=$COMPONENT rc=$rc cmd=$BASH_COMMAND"
  exit $rc
}
trap on_error ERR

console "TOXIC_MOD_USER_DATA_START component=$COMPONENT region=$REGION"

# ---------------------------------------------------------------------------
# 1. Docker engine
# ---------------------------------------------------------------------------
dnf -y install docker
systemctl enable --now docker
usermod -aG docker ec2-user

# ---------------------------------------------------------------------------
# 2. Docker Compose v2 plugin
#
# AL2023 has NO docker-compose-plugin package. `dnf install docker` installs the
# engine and the CLI and nothing else, so `docker compose` does not exist until
# this block runs -- which is the failure that would turn Phase 5's compose-based
# roll into a day-13 surprise.
#
# The expected digest is ${compose_sha256}, pinned as a literal in compute.tf and
# code-reviewed there. It is deliberately NOT the .sha256 file GitHub publishes
# beside the binary: fetching the digest from the same host as the artifact
# proves the transfer was not truncated and proves nothing about provenance,
# because anything able to serve a malicious binary can serve its digest too.
# The delivery spec makes independent recording of an expected digest normative
# ("recorded independently ... never derived from the artifact being loaded").
# ---------------------------------------------------------------------------
install -d -m 0755 "$COMPOSE_PLUGIN_DIR"
compose_tmp=$(mktemp -d)
curl -fsSL --retry 5 --retry-delay 3 --retry-connrefused --max-time 300 \
  -o "$compose_tmp/docker-compose" \
  'https://github.com/docker/compose/releases/download/${compose_version}/docker-compose-linux-aarch64'
printf '%s  %s\n' '${compose_sha256}' "$compose_tmp/docker-compose" | sha256sum -c -
install -m 0755 "$compose_tmp/docker-compose" "$COMPOSE_PLUGIN_DIR/docker-compose"
rm -rf "$compose_tmp"
docker compose version

# ---------------------------------------------------------------------------
# 3. Deploy-time environment
#
# Phase 5's docker-compose.yml and its SSM roll read this file and nothing else.
# It holds addresses and names only: every secret is fetched at container start
# from Secrets Manager through the instance profile.
#
# TOXIC_MOD_BACKEND_URL is the backend's PRIVATE address on purpose. The frontend
# security group permits egress to 8000 only within the public subnet CIDRs, so
# traffic aimed at the backend's Elastic IP would leave through the internet
# gateway, miss that rule, and be dropped. The public backend_url in outputs.tf
# is for humans and graders, not for instance-to-instance calls.
# ---------------------------------------------------------------------------
cat >"$ENV_FILE" <<'TOXICMODENV'
AWS_REGION=${region}
AWS_DEFAULT_REGION=${region}
TOXIC_MOD_COMPONENT=${component}
TOXIC_MOD_LOG_GROUP=${log_group}
TOXIC_MOD_ECR_REGISTRY=${ecr_registry}
TOXIC_MOD_BACKEND_URL=${backend_url}
TOXIC_MOD_DB_HOST=${db_host}
TOXIC_MOD_DB_PORT=${db_port}
TOXIC_MOD_DB_NAME=${db_name}
TOXICMODENV
chmod 0644 "$ENV_FILE"

# ---------------------------------------------------------------------------
# 4. Container logs must leave the box (premortem H27)
#
# The daemon default is set so a container started by hand, by compose, or by
# SSM Run Command all ship to CloudWatch without anyone remembering to pass
# --log-driver. The log group already exists in Terraform, so the instance role
# needs CreateLogStream and PutLogEvents only, never logs:CreateLogGroup.
#
# Two consequences worth knowing before debugging this box:
#   - `docker logs` stops working locally; read the group instead:
#       aws logs tail ${log_group} --follow
#   - the monitoring host also runs the re-scorer, whose container must pass
#       --log-opt awslogs-group=/<project>/rescorer
#     explicitly, because this default points at the monitoring group.
#
# The explicit per-container form, for SSM Run Command and the runbooks:
#   docker run --log-driver=awslogs \
#     --log-opt awslogs-region=${region} \
#     --log-opt awslogs-group=${log_group} \
#     --log-opt awslogs-stream=${component} ...
#
# A malformed daemon.json bricks Docker on a host with no SSH, so the config is
# accepted only after the daemon is proven to come back. If it does not, the
# file is removed and Docker restarted: degraded logging beats a dead engine,
# and the ROLLBACK marker on the console says which one happened.
# ---------------------------------------------------------------------------
install -d -m 0755 /etc/docker
cat >/etc/docker/daemon.json <<'TOXICMODDOCKER'
{
  "log-driver": "awslogs",
  "log-opts": {
    "awslogs-region": "${region}",
    "awslogs-group": "${log_group}"
  }
}
TOXICMODDOCKER

docker_ready() {
  for _ in $(seq 1 15); do
    docker info >/dev/null 2>&1 && return 0
    sleep 2
  done
  return 1
}

if ! systemctl restart docker || ! docker_ready; then
  console "TOXIC_MOD_USER_DATA_LOGDRIVER_ROLLBACK component=$COMPONENT"
  rm -f /etc/docker/daemon.json
  systemctl restart docker
  docker_ready
fi

# ---------------------------------------------------------------------------
# 5. ECR login helper
#
# An ECR authorization token expires after 12 hours, so logging in once during
# bootstrap would leave a stopped-then-started instance unable to pull. The
# helper is written here and invoked as ExecStartPre on every boot instead.
# ---------------------------------------------------------------------------
cat >/usr/local/bin/toxic-mod-ecr-login <<'TOXICMODLOGIN'
#!/bin/bash
set -euo pipefail
aws ecr get-login-password --region '${region}' \
  | docker login --username AWS --password-stdin '${ecr_registry}'
TOXICMODLOGIN
chmod 0755 /usr/local/bin/toxic-mod-ecr-login

# ---------------------------------------------------------------------------
# 6. Start the APPLICATION at boot, not just the instance
#
# The cost model instructs stopping EC2 and RDS between sessions and a nightly
# EventBridge schedule enforces it, so this host is started far more often than
# it is created. Without this unit, `make aws-up` returns three running
# instances and zero running containers, and the demo URL is dead until somebody
# re-runs the deploy workflow.
#
# ConditionPathExists makes the unit a no-op until Phase 5's deploy lands a
# compose file: `systemctl status` then reads "condition failed" rather than
# "failed", so a first boot does not leave a red unit behind.
#
# CONTRACT WITH PHASE 5: the deploy must write exactly
#   /opt/toxic-mod/docker-compose.yml
# Not compose.yaml, not a subdirectory. Both the condition and -f name that
# path literally, so a different filename silently produces a running instance
# with no containers -- which is the failure this unit exists to prevent.
# ---------------------------------------------------------------------------
install -d -m 0755 "$APP_DIR"

cat >"$UNIT" <<'TOXICMODUNIT'
[Unit]
Description=toxic-moderation application stack (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/opt/toxic-mod/docker-compose.yml

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/toxic-mod
EnvironmentFile=/etc/toxic-mod.env
ExecStartPre=/usr/local/bin/toxic-mod-ecr-login
ExecStart=/usr/bin/docker compose -f /opt/toxic-mod/docker-compose.yml --env-file /etc/toxic-mod.env up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f /opt/toxic-mod/docker-compose.yml down --remove-orphans
TimeoutStartSec=900
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=multi-user.target
TOXICMODUNIT

systemctl daemon-reload
systemctl enable toxic-mod.service
systemctl start toxic-mod.service || systemctl status --no-pager --full toxic-mod.service || true

# ---------------------------------------------------------------------------
# 6b. Warm the ECR credential
#
# Non-fatal and retried: an instance profile can take a few seconds to become
# usable, and a transient 403 here must not abort a bootstrap that has already
# installed everything the deploy needs. The outcome is reported in the marker
# below as ecr_login=ok|failed rather than being swallowed.
# ---------------------------------------------------------------------------
ECR_LOGIN=failed
for attempt in 1 2 3 4 5; do
  if /usr/local/bin/toxic-mod-ecr-login; then
    ECR_LOGIN=ok
    break
  fi
  console "TOXIC_MOD_USER_DATA_ECR_LOGIN_RETRY component=$COMPONENT attempt=$attempt"
  sleep 10
done

# ---------------------------------------------------------------------------
# 7. Externally observable success marker
#
# "Externally observable" means observable from a laptop with the AWS CLI and
# nothing else -- no SSH, no SSM session, no container. Three channels, in the
# order they survive failure:
#
#   1. Serial console. Survives a dead SSM agent, which is the C6 failure mode:
#        aws ec2 get-console-output --instance-id i-... --output text \
#          | grep TOXIC_MOD_USER_DATA_
#   2. CloudWatch Logs, stream "bootstrap" in this tier's own group:
#        aws logs tail ${log_group} --since 30m
#      Best effort: a logging permission problem must not fail a boot that
#      otherwise succeeded, so both calls are non-fatal.
#   3. Sentinel file, for an SSM Run Command check after the fact:
#        test -f /var/lib/cloud/toxic-mod-bootstrapped
#
# Reading the instance id through IMDSv2 is also the live proof that
# http_tokens=required and http_put_response_hop_limit=2 are working: this exact
# PUT-then-GET is what a container does to obtain credentials, so if it fails
# here the ERR trap says so on the console instead of the failure surfacing as
# "Unable to locate credentials" inside a container three hours later.
# ---------------------------------------------------------------------------
IMDS_TOKEN=$(curl -fsS --max-time 5 -X PUT 'http://169.254.169.254/latest/api/token' \
  -H 'X-aws-ec2-metadata-token-ttl-seconds: 300')
INSTANCE_ID=$(curl -fsS --max-time 5 -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" \
  'http://169.254.169.254/latest/meta-data/instance-id')

MARKER="TOXIC_MOD_USER_DATA_COMPLETE component=$COMPONENT instance=$INSTANCE_ID compose=${compose_version} ecr_login=$ECR_LOGIN at=$(date -u +%FT%TZ)"

printf '%s\n' "$MARKER" >"$SENTINEL"
chmod 0644 "$SENTINEL"
console "$MARKER"

aws logs create-log-stream --region "$REGION" \
  --log-group-name "$LOG_GROUP" --log-stream-name bootstrap >/dev/null 2>&1 || true
aws logs put-log-events --region "$REGION" \
  --log-group-name "$LOG_GROUP" --log-stream-name bootstrap \
  --log-events "$(printf '[{"timestamp":%s000,"message":"%s"}]' "$(date +%s)" "$MARKER")" \
  >/dev/null 2>&1 || true

sync
