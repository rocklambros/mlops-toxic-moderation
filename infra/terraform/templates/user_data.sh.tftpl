#!/bin/bash
# ---------------------------------------------------------------------------
# Amazon Linux 2023 (arm64) bootstrap for one tier of the toxic-moderation
# stack. Rendered by templatefile() from infra/terraform/compute.tf, once per
# instance, with that component's name and log group baked in.
#
# Terraform template variables: ${region} ${component} ${log_group}
#                               ${ecr_registry}
#
# This host has no SSH, no bastion and no NAT (foundation spec 7.1). Everything
# below therefore assumes that if it fails, the only evidence available is what
# reached the serial console. Three rules follow from that:
#
#   1. Every line of output goes to /dev/console, so `aws ec2 get-console-output`
#      works even when the SSM agent never registered (premortem C6).
#   2. An ERR trap prints a FAILED marker naming the command that died, because
#      "user data did not finish" is not a diagnosis.
#   3. The script ends with an externally observable COMPLETE marker on four
#      independent channels. See the last section.
#
# Ordering rule: anything that can fail on a transient AWS condition runs AFTER
# the systemd unit is installed, so a slow IAM propagation cannot leave the box
# without the thing that starts the application on the next boot.
#
# Nothing secret is written by this script. The instance profile is the only
# credential on the box; there are no static keys anywhere.
# ---------------------------------------------------------------------------
set -euxo pipefail
# `-E` as well, and deliberately on its own line. It propagates the ERR trap into
# functions and subshells, so a failure inside one of the helpers below is
# reported by on_error rather than returning quietly. Kept separate because the
# combined form is the string tests/unit/test_user_data.py pins, and a bootstrap
# that loses `-e` is a bootstrap that reports success after failing.
set -E

exec > >(tee /var/log/user-data.log | logger -t user-data -s 2>/dev/console) 2>&1

COMPONENT='${component}'
REGION='${region}'
LOG_GROUP='${log_group}'

APP_DIR=/opt/toxic
STATE_DIR=/var/lib/toxic
UNIT=/etc/systemd/system/toxic-stack.service
SENTINEL=/var/lib/cloud/toxic-stack-bootstrapped

# `docker` searches several cli-plugins directories; /usr/libexec/docker/cli-plugins
# is the one the AL2023 docker package itself owns, so a plugin dropped here is
# found by the packaged CLI with no DOCKER_CONFIG or PATH manipulation.
COMPOSE_PLUGIN_DIR=/usr/libexec/docker/cli-plugins

# The Compose v2 CLI plugin is not in the AL2023 repositories under any package
# name, so it is fetched as a release binary and checked against this digest
# before it is installed. Installing an unverified binary here would be a
# supply-chain hole on a host that holds an instance profile.
#
# The digest is recorded HERE, in the reviewed source, and is deliberately NOT
# the file published beside the binary: fetching the expected value from the
# same host that serves the artifact proves the transfer was not truncated and
# proves nothing about provenance, because anything able to serve a malicious
# binary can serve its expected digest too. The delivery spec makes independent
# recording of an expected digest normative.
#
# Bump the two lines together, from the release's published checksum list, and
# review them as a pair. They live here rather than in compute.tf so that there
# is exactly one copy of a value whose whole purpose is to be compared.
COMPOSE_VERSION=v5.3.1
COMPOSE_SHA256=aa611e811d0ea25897839c404bfb5bf93ce706dc51c500a4457890f5d0606a86

console() {
  printf '%s\n' "$*" >/dev/console 2>/dev/null || true
  printf '%s\n' "$*"
}

on_error() {
  rc=$?
  console "TOXIC-USER-DATA-FAILED component=$COMPONENT rc=$rc cmd=$BASH_COMMAND"
  exit $rc
}
trap on_error ERR

console "TOXIC-USER-DATA-START component=$COMPONENT region=$REGION"

# ---------------------------------------------------------------------------
# 1. Directories
#
# /etc/toxic is 0700 because roll.sh writes credentials into it. A 0755
# directory leaves a 0600 file listable, and anything written into it later by
# hand inherits the default umask.
#
# CONTRACT WITH THE DEPLOY (Phase 5 Tasks 9 and 10). Nothing here fetches an
# application artifact, because the SSM roll is the delivery path by design:
#   /opt/toxic/compose.<component>.yml   the component compose file
#   /opt/toxic/{bootstrap,roll,fetch_artifacts}.sh
#   /etc/toxic/stack.env                 AWS_REGION and the LOG_GROUP_* names
#   /etc/toxic/<service>.env             0600, written from Secrets Manager
#   /var/lib/toxic/artifacts/            digest-verified model artifacts
# Until the first roll lands, /opt/toxic/compose.yml is a dangling symlink, the
# unit's ConditionPathExists is false, and `systemctl status` reads "condition
# failed" rather than "failed". That is the intended first-boot state.
# ---------------------------------------------------------------------------
install -d -m 0755 "$APP_DIR" "$STATE_DIR" "$STATE_DIR/artifacts" "$STATE_DIR/spool"
install -d -m 0700 /etc/toxic

# ---------------------------------------------------------------------------
# 2. Prove there is a route out before anything needs one (premortem H26)
#
# aws_eip_association runs AFTER this instance is created, so until it lands the
# only route out is the address the subnet auto-assigns. network.tf sets
# map_public_ip_on_launch on both public subnets for exactly this reason. If it
# is ever turned off there is no route at all: package installs hang, the
# Compose download fails, and the SSM Agent never reaches ssm and ssmmessages on
# 443 -- so the instance never registers, and with no SSH, no bastion and no NAT
# that is an unrecoverable box. The worst version of that is a silent hang, so
# the wait is bounded and names the three knobs to check when it gives up.
#
# The loop probes the regional SSM endpoint, because SSM reachability is the
# property that decides whether this host is recoverable at all. `-f` is
# deliberately absent: any HTTP response, including an unauthenticated 404,
# proves DNS, routing and a TLS handshake on 443. Authorisation is a different
# question and is not this one. The loop is the retry, so the probe does not
# also retry internally.
# ---------------------------------------------------------------------------
EGRESS_WAIT_SECONDS=300

wait_for_egress() {
  local deadline
  deadline=$(( $(date +%s) + EGRESS_WAIT_SECONDS ))
  until curl -sS -o /dev/null --max-time 8 "https://ssm.$REGION.amazonaws.com"; do
    if [ "$(date +%s)" -ge "$deadline" ]; then
      console "TOXIC-USER-DATA-FAILED component=$COMPONENT reason=no egress route after $EGRESS_WAIT_SECONDS seconds -- check map_public_ip_on_launch on the public subnets, the 0.0.0.0/0 route on the public route table, and the security group egress rules"
      return 1
    fi
    sleep 5
  done
}

wait_for_egress
# Which address this host actually goes out as. Diagnostic, not a gate: before
# the EIP associates it is the subnet's auto-assigned address and afterwards it
# is the Elastic IP, and knowing which one answered is the difference between
# "the association has not landed yet" and "the association is broken".
curl -fsS --retry 3 --retry-delay 2 --max-time 15 -o /var/log/toxic-egress-address https://checkip.amazonaws.com
console "TOXIC-USER-DATA-EGRESS-OK component=$COMPONENT address=$(cat /var/log/toxic-egress-address)"

# ---------------------------------------------------------------------------
# 3. Docker engine
# ---------------------------------------------------------------------------
dnf -y install docker
systemctl enable --now docker
usermod -aG docker ec2-user

# ---------------------------------------------------------------------------
# 4. Docker Compose v2 plugin
#
# `dnf install docker` installs the engine and the CLI and nothing else, so
# `docker compose` does not exist until this block runs -- which is the failure
# that would turn the compose-based roll into a day-13 surprise.
# ---------------------------------------------------------------------------
install -d -m 0755 "$COMPOSE_PLUGIN_DIR"
compose_tmp="$(mktemp -d)"
curl -fsSL --retry 8 --retry-delay 5 --retry-connrefused --max-time 300 \
  -o "$compose_tmp/docker-compose" \
  "https://github.com/docker/compose/releases/download/$COMPOSE_VERSION/docker-compose-linux-aarch64"
printf '%s  %s\n' "$COMPOSE_SHA256" "$compose_tmp/docker-compose" | sha256sum -c -
install -m 0755 "$compose_tmp/docker-compose" /usr/libexec/docker/cli-plugins/docker-compose
rm -rf "$compose_tmp"
docker compose version

# ---------------------------------------------------------------------------
# 5. Container logs must leave the box (premortem H27)
#
# The daemon default is set so a container started by hand, by compose, or by
# SSM Run Command all ship to CloudWatch without anyone remembering to pass
# --log-driver. The production compose files still name a group and a stream
# explicitly, because the re-scorer shares the monitoring host and would
# otherwise interleave with the graded dashboard. The log group already exists
# in Terraform, so the instance role needs CreateLogStream and PutLogEvents
# only, never logs:CreateLogGroup.
#
# `docker logs` stops working locally once this is in force; read the group:
#   aws logs tail ${log_group} --follow
#
# A malformed daemon.json bricks Docker on a host with no SSH, so the config is
# accepted only after the daemon is proven to come back. If it does not, the
# file is removed and Docker restarted: degraded logging beats a dead engine,
# and the ROLLBACK marker on the console says which one happened.
# ---------------------------------------------------------------------------
install -d -m 0755 /etc/docker
cat >/etc/docker/daemon.json <<'TOXICDOCKERD'
{
  "log-driver": "awslogs",
  "log-opts": {
    "awslogs-region": "${region}",
    "awslogs-group": "${log_group}"
  }
}
TOXICDOCKERD

docker_ready() {
  for _ in $(seq 1 15); do
    docker info >/dev/null 2>&1 && return 0
    sleep 2
  done
  return 1
}

if ! systemctl restart docker || ! docker_ready; then
  console "TOXIC-USER-DATA-LOGDRIVER-ROLLBACK component=$COMPONENT"
  rm -f /etc/docker/daemon.json
  systemctl restart docker
  docker_ready
fi

# ---------------------------------------------------------------------------
# 6. ECR login helper
#
# An ECR authorization token expires after 12 hours, so logging in once during
# bootstrap would leave a stopped-then-started instance unable to pull. The
# helper is written here and invoked as ExecStartPre on every boot instead.
# ---------------------------------------------------------------------------
cat >/usr/local/bin/toxic-ecr-login <<'TOXICECRLOGIN'
#!/bin/bash
set -euo pipefail
aws ecr get-login-password --region '${region}' \
  | docker login --username AWS --password-stdin '${ecr_registry}'
TOXICECRLOGIN
chmod 0755 /usr/local/bin/toxic-ecr-login

# ---------------------------------------------------------------------------
# 7. Start the APPLICATION at boot, not just the instance (REG-5)
#
# The cost model instructs stopping EC2 and RDS between sessions and a nightly
# EventBridge schedule enforces it, so this host is started far more often than
# it is created. Without this unit, `make aws-up` returns three running
# instances and zero running containers, and the demo URL is dead until somebody
# re-runs the deploy workflow.
#
# The unit is carried inline rather than fetched, because on a first boot
# nothing has delivered anything to this host yet. tests/unit/test_user_data.py
# asserts this heredoc is byte-for-byte infra/deploy/toxic-stack.service, which
# is the file tests/unit/test_systemd_unit.py makes its assertions about.
# ---------------------------------------------------------------------------
cat >"$UNIT" <<'TOXICSTACKUNIT'
[Unit]
Description=Toxic moderation stack
Documentation=https://github.com/rocklambros/mlops-toxic-moderation/blob/main/infra/ROLLBACK.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
# A first boot happens before any deploy has uploaded anything, so there is nothing to
# start. Without this, the unit fails and retries every RestartSec forever and
# `systemctl status` reads "failed" on a host with no SSH -- indistinguishable from a real
# fault. With it, it reads "condition failed", which is the truth.
#
# /opt/toxic/compose.yml is a symlink that user data points at this instance's component
# file, so one unit serves all three instances without a template parameter. A dangling
# symlink does not satisfy ConditionPathExists, which is the wanted behaviour: the compose
# file the symlink names has to actually be there.
ConditionPathExists=/opt/toxic/compose.yml

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/toxic
# An ECR authorization token expires after 12 hours and the stack is stopped between
# sessions by design, so the token obtained during bootstrap is always expired by the next
# start. The leading '-' makes failure non-fatal: a transient IAM or network problem must
# not stop containers whose images are already on disk from coming back.
ExecStartPre=-/usr/local/bin/toxic-ecr-login
ExecStart=/usr/bin/docker compose --env-file /etc/toxic/stack.env -f /opt/toxic/compose.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose --env-file /etc/toxic/stack.env -f /opt/toxic/compose.yml down
# A cold pull of five arm64 images over the instance's own egress, with no NAT and no
# registry cache in front of it.
TimeoutStartSec=900
# RDS can still be starting when EC2 finishes booting, and the backend's lifespan fails
# closed on an unreachable database. One failure is not terminal.
Restart=on-failure
RestartSec=20

[Install]
WantedBy=multi-user.target
TOXICSTACKUNIT

# One unit serves all three instances: this symlink is the only thing that
# differs between them, and it is what tells the host which component it runs.
ln -sfn "$APP_DIR/compose.${component}.yml" /opt/toxic/compose.yml

systemctl daemon-reload
systemctl enable toxic-stack.service

# ---------------------------------------------------------------------------
# 8. Warm the ECR credential
#
# Non-fatal and retried: an instance profile can take a few seconds to become
# usable, and a transient 403 here must not abort a bootstrap that has already
# installed everything the deploy needs. The outcome is carried into the marker
# as ecr_login=ok|failed rather than being swallowed.
# ---------------------------------------------------------------------------
ECR_LOGIN=failed
for attempt in 1 2 3 4 5; do
  if /usr/local/bin/toxic-ecr-login; then
    ECR_LOGIN=ok
    break
  fi
  console "TOXIC-USER-DATA-ECR-LOGIN-RETRY component=$COMPONENT attempt=$attempt"
  sleep 10
done

# ---------------------------------------------------------------------------
# 9. Externally observable success marker (premortem H26)
#
# "Externally observable" means observable from a laptop with the AWS CLI and
# nothing else -- no SSH, no SSM session, no container. A boot that half
# succeeded looks exactly like a boot that is still in progress, so the operator
# needs one question with a yes-or-no answer that can be asked from outside.
# Four channels, in the order they survive failure:
#
#   1. Serial console. Survives a dead SSM agent, which is the C6 failure mode:
#        aws ec2 get-console-output --instance-id i-... --output text \
#          | grep TOXIC-USER-DATA-
#   2. Sentinel file, for an SSM Run Command check after the fact:
#        test -f /var/lib/cloud/toxic-stack-bootstrapped
#   3. CloudWatch Logs, stream "bootstrap" in this tier's own group:
#        aws logs tail ${log_group} --since 30m
#      Best effort: a logging permission problem must not fail a boot that
#      otherwise succeeded, so both calls are non-fatal.
#   4. SSM Parameter Store, and this one is the LAST LINE deliberately:
#        aws ssm get-parameter --name /toxic/boot/<component>
#      Everything above either succeeded or `set -e` already killed this script,
#      so the presence of that parameter is the whole answer to "did the boot
#      finish?". It is NOT written with `|| true`: aws_up.sh waits on it, and a
#      marker that may be absent on a successful boot is a marker that cannot be
#      waited on -- worse, a swallowed failure leaves the PREVIOUS boot's value
#      in place and the wait returns immediately on a stale answer. If
#      PutParameter is denied, the ERR trap says so on the console, which is
#      exactly the diagnosis wanted. The grant is aws_iam_role_policy.boot_marker
#      in iam.tf, scoped to /toxic/boot/*.
#
# The marker answers "user data finished", NOT "the application is up".
# verify_deploy.sh answers the second question, and conflating the two would
# hide which of them failed.
#
# Reading through IMDSv2 is also the live proof that http_tokens=required and
# http_put_response_hop_limit=2 are working: this exact PUT-then-GET is what a
# container does to obtain credentials, so a failure here surfaces on the
# console now instead of as "Unable to locate credentials" three hours later.
# ---------------------------------------------------------------------------
IMDS_TOKEN="$(curl -fsS --retry 3 --retry-delay 2 --max-time 10 -X PUT 'http://169.254.169.254/latest/api/token' -H 'X-aws-ec2-metadata-token-ttl-seconds: 300')"
AMI_ID="$(curl -fsS --retry 3 --retry-delay 2 --max-time 10 -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" 'http://169.254.169.254/latest/meta-data/ami-id')"
INSTANCE_ID="$(curl -fsS --retry 3 --retry-delay 2 --max-time 10 -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" 'http://169.254.169.254/latest/meta-data/instance-id')"
BOOTED_AT="$(date -Is)"

MARKER="TOXIC-USER-DATA-COMPLETE component=$COMPONENT instance=$INSTANCE_ID ami=$AMI_ID compose=$COMPOSE_VERSION ecr_login=$ECR_LOGIN at=$BOOTED_AT"

printf '%s\n' "$MARKER" >"$SENTINEL"
chmod 0644 "$SENTINEL"
console "$MARKER"
sync

aws logs create-log-stream --region "$REGION" \
  --log-group-name "$LOG_GROUP" --log-stream-name bootstrap >/dev/null 2>&1 || true
aws logs put-log-events --region "$REGION" \
  --log-group-name "$LOG_GROUP" --log-stream-name bootstrap \
  --log-events "$(printf '[{"timestamp":%s000,"message":"%s"}]' "$(date +%s)" "$MARKER")" \
  >/dev/null 2>&1 || true

aws ssm put-parameter --region ${region} --name "/toxic/boot/${component}" --type String --overwrite --value "ok $BOOTED_AT $AMI_ID"
