# Python
__pycache__/
*.py[cod]
*.egg-info/
/.eggs/
/build/
/dist/
/.venv/
/venv/
/env/

# Environment and secrets
.env
*.env
!.env.example
/secrets/
*.pem
*.key

# Account, organization, and instance identifiers. Not credentials, but the repo
# is public and these aid targeting and enumeration. Committed docs use
# placeholders and resolve them from these files.
*.local.md
infra/aws/bootstrap-outputs.env

# Superseded AWS Academy Learner Lab requirements note. Carries a Vocareum
# `vockey` session token inside its URLs, so it must never reach this public
# repository. The Learner Lab path was abandoned 2026-07-30 in favour of a
# dedicated Organizations member account.
claudedocs/mlops_final_project_requrements_aws.md

# Data (raw Jigsaw dataset and derived splits are not versioned in git).
# LEADING SLASH IS LOAD-BEARING: an unanchored `data/` matches any directory named
# data at ANY depth, and silently excluded model/data/ -- the whole Phase 0 pipeline --
# from ten commits. Tests passed locally because the files were on disk; a fresh clone
# had no data pipeline at all.
/data/
*.csv
# ...but the synthetic test fixture is a committed source artifact, not data.
!tests/fixtures/*.csv
*.csv.gz
*.parquet

# Model artifacts (fetched from W&B by digest at deploy time, never committed)
/artifacts/
*.onnx
*.skops
*.safetensors
*.bin
*.pt
*.pth
*.joblib
*.pkl

# Weights & Biases local run cache
/wandb/

# Test and lint caches
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/

# OS and editor
.DS_Store
.idea/
.vscode/
*.swp

# Python virtualenvs
/.venv/
/.venv-lock/

# Raw dataset, fetched by scripts/fetch_jigsaw.sh, never committed
/data/raw/

# RunPod launch registry: runtime state, not source. It records live pod ids so a crash
# between "pod created" and "pod ready" still leaves something terminatable. Committing it
# would ship one machine's live pods to every other clone.
infra/runpod/runpod_pods.json
